# Copie este archivo como ".env" y cambie los valores. El archivo ".env" NO debe subirse a Git.
DB_PASSWORD=cambie_esta_clave
# Al menos 32 caracteres, aleatorio y secreto.
JWT_SECRET=cambie_este_secreto_por_uno_aleatorio_de_32_o_mas_caracteres
# Opcional: puerto del equipo donde se publica la API (por defecto 8080).
# API_PORT=8080
